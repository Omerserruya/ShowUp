
# Nginx
HTTP_PORT=80
HTTPS_PORT=8443
BACKEND_PROTOCOL=http
AUB_SERVICE_HOST=aub-service

# Postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=appdb
DB_PORT=5432
PGDATA=/opt/services/postgres

# RabbitMQ
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# Redis
REDIS_PORT=6379
REDIS_DATA=/opt/services/redis

# AUB Service
AUB_SERVICE_PORT=5001
OUTPOST_QUEUE_NAME=aub_outpost_queue
WHATSAPP_OTP_TEMPLATE=whatsapp_otp_template
OTP_TTL_SEC=300

# JWT
JWT_SECRET=3f5e70218cb7c20acf1438636f0fda5880a521ecdc294549f45b69e4abb0f462
JWT_EXP_SECONDS=3600

# Core Service
CORE_SERVICE_PORT=5000

# Webhook handler
WEBHOOK_HANDLER_PORT=6000

# Wevhook Worker
WEBHOOK_WORKER_PORT=7000

