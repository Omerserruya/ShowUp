# Outpost Service Environment Variables

# WhatsApp Business API Configuration
WA_API_B=your_whatsapp_business_api_token_here
WA_PHONE_ID=your_whatsapp_business_phone_number_id_here

# RabbitMQ Configuration
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Queue Configuration
OUTPOST_QUEUE_NAME=outpost_queue

# Logging Configuration
LOG_LEVEL=INFO

# Interactive / owner-facing lane (declared durable, NO arguments, by producers too)
OUTPOST_PRIORITY_QUEUE=outpost_priority_queue

# Throughput: per-lane prefetch (= concurrency by default) and per-number rate cap
OUTPOST_PREFETCH=20
OUTPOST_PRIORITY_PREFETCH=10
# OUTPOST_CONCURRENCY=20
# OUTPOST_PRIORITY_CONCURRENCY=10
OUTPOST_MAX_MPS=40          # per phone_number_id, per replica (Meta cap ~80)
OUTPOST_DB_POOL_SIZE=8

# Retries (seconds per attempt tier; queues <q>.retry.<n> are created from these)
OUTPOST_MAX_ATTEMPTS=5
OUTPOST_RETRY_DELAYS=30,120,480,1200,2400
OUTPOST_PRIORITY_RETRY_DELAYS=2,10,30,120,300
OUTPOST_BREAKER_PROBE_SECONDS=300
OUTPOST_STALE_CLAIM_MINUTES=10
